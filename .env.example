# ==============================================================================
# RACEPULSE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ==============================================================================
# 1. FRONTEND / VERCEL ENVIRONMENT VARIABLES
# ==============================================================================
# Base REST API URL of the backend (e.g., https://racepulse-backend.onrender.com/api/v1)
VITE_API_URL=http://localhost:8080/api/v1

# WebSocket URL for real-time live telemetry (e.g., wss://racepulse-backend.onrender.com/ws-raw)
VITE_WS_URL=ws://localhost:8080/ws-raw

# ==============================================================================
# 2. BACKEND / RENDER ENVIRONMENT VARIABLES
# ==============================================================================
# Port assigned dynamically by Render or local environment (default: 8080)
PORT=8080

# Redis Cache connection settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Allowed CORS origins for REST & WebSocket endpoints (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://racepulse.vercel.app

# External upstream live data providers
OPENF1_BASE_URL=https://api.openf1.org/v1
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# Optional AI & Third-Party service integration keys
GROQ_API_KEY=
YOUTUBE_API_KEY=
GNEWS_API_KEY=

# ==============================================================================
# 3. LOCAL DOCKER COMPOSE CONFIGURATION
# ==============================================================================
# When running with docker compose, Redis service is mapped to 'redis:6379'
# and backend communicates directly via Docker internal networking.
